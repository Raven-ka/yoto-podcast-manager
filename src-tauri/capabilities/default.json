{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:default",
    "opener:allow-open-url",
    "sql:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    "sql:allow-execute",
    "sql:allow-select",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" }
      ]
    }
  ]
}
